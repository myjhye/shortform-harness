# Python standard gitignore
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
venv/
ENV/
env/
.venv/

# Environment file
.env

# OS generated files
.DS_Store

# Generated output and reference media
outputs/videos/*.mp4
outputs/style_specs/*.json
outputs/cut_check/
outputs/cut_check_ref2/
outputs/test_frames/
outputs/temp_frames/
outputs/temp/
outputs/test_tts/
outputs/test_images/
outputs/test_videos/
outputs/test_final/
outputs/vision_test/
outputs/vision_test_ref2/
references/*.mp4

# External reference codebase
reference/

# Preserve directory structure .gitkeep files
!outputs/style_specs/.gitkeep
!outputs/videos/.gitkeep
!references/.gitkeep
